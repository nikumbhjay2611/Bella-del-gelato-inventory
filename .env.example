# Browser-visible project configuration only (Supabase publishable key is designed for client use).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Never prefix these with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
RESEND_API_KEY=re_YOUR_RESEND_KEY
REPORT_FROM_EMAIL=Bella del Gelato <reports@your-verified-domain.com>
CRON_SECRET=USE_A_LONG_RANDOM_SECRET_FROM_A_PASSWORD_MANAGER
